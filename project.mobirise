    "google-analytics": "<!-- Google tag (gtag.js) -->\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-VV58D0KGZJ\"></script>\n<script>\n  window.dataLayer = window.dataLayer || [];\n  function gtag(){dataLayer.push(arguments);}\n  gtag('js', new Date());\n\n  gtag('config', 'G-VV58D0KGZJ');\n</script>",
    "global_after_body": "<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org/\", \n  \"@type\": \"BreadcrumbList\", \n  \"itemListElement\": [{\n    \"@type\": \"ListItem\", \n    \"position\": 1, \n    \"name\": \"OSO ARUBA TOUR explore Aruba’s wild side in a private Jeep with your own local guide.\",\n    \"item\": \"https://osoarubatour.com/\"  \n  },{\n    \"@type\": \"ListItem\", \n    \"position\": 2, \n    \"name\": \"OSO ARUBA TOURS RENTALS\",\n    \"item\": \"https://osoarubatour.com/OSO-ARUBA-TOURS-RENTALS\"  \n  },{\n    \"@type\": \"ListItem\", \n    \"position\": 3, \n    \"name\": \"Contact OSO ARUBA TOURS\",\n    \"item\": \"https://osoarubatour.com/Contact-JEEP-TOURS-ARUBA\"  \n  }]\n}\n</script>\n\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org/\",\n  \"@type\": \"WebSite\",\n  \"name\": \"OSO ARUBA JEEP TOURS\",\n  \"url\": \"https://osoarubatour.com/\",\n  \"potentialAction\": {\n    \"@type\": \"SearchAction\",\n    \"target\": \"{search_term_string}\",\n    \"query-input\": \"required name=search_term_string\"\n  }\n}\n</script>\n\n<!-- begin code v 7.0 -->\n<span id=\"wts2200763\"></span>\n<script>var wts=document.createElement('script');wts.async=true;\nwts.src='https://app.ardalio.com/wts7.js';document.head.appendChild(wts);\nwts.onload = function(){ wtsl7(2200763,1); };\n</script><noscript><img src=\"https://app.ardalio.com/7/1/2200763.png\"></noscript>\n<!-- end code v 7.0 -->\n\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [{\n    \"@type\": \"Question\",\n    \"name\": \"Do we drive our own vehicle, or is there a guide?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"All of OSO ARUBA TOURS have a driver/guide who drives the Jeep. When you book a tour, you will be a passenger in the Jeep and will not be driving a vehicle.\"\n    }\n  },{\n    \"@type\": \"Question\",\n    \"name\": \"Do I need a driver's license to participate in the tour?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"A valid driver’s license for ages 25 years old and above is required to drive the Jeep during the tour. Otherwise, you can ride as a passenger while a guide or another licensed participant drives.\"\n    }\n  },{\n    \"@type\": \"Question\",\n    \"name\": \"How long do the Jeep tours last?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"OSO ARUBA TOURS tours range from 3 to 4 hours. Custom itineraries can also be adjusted to fit your schedule.\"\n    }\n  },{\n    \"@type\": \"Question\",\n    \"name\": \"What should I bring on the Jeep tour?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"OSO ARUBA TOURS recommends bringing sunscreen, a hat, comfortable clothing and shoes, sunglasses, a camera, water, and any personal items. If your tour includes beach stops, pack swimwear and towels.\"\n    }\n  },{\n    \"@type\": \"Question\",\n    \"name\": \"Can I get a private tour?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"Yes! OSO ARUBA TOURS offers private tours for parties of 4 or more guests. Parties of 2 or 3 guests may book a private tour, but they must pay for 4 guests. Private tours are offered “by the seat” or “by the whole Jeep.” Hotel pickup is available on private tours booked “by the whole jeep” only.\"\n    }\n  },{\n    \"@type\": \"Question\",\n    \"name\": \"Can we rent a Jeep from you?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"Yes! we do Jeep makes the perfect car rental for action-packed family vacations and adventures. Are you feeling a little adventurous and want to drive yourself? Choose a OSO ARUBA TOURS rental Jeep for a memorable vacation wherever you choose to travel.\"\n    }\n  }]\n}\n</script>\n\n<!-- Basic OpenGraph Tags -->\n<meta property=\"og:title\" content=\"OSO ARUBA JEEP TOURS\" />\n<meta property=\"og:description\" content=\"OSO Your Leading Aruba Jeep Tour Operator. Explore Aruba’s wild side in a Jeep with your own local guide.\" />\n<meta property=\"og:image\" content=\"https://osoarubatour.com/assets/images/oso-logo-circle-logo.png\" />\n<meta property=\"og:url\" content=\"https://osoarubatour.com/\" />\n<meta property=\"og:site_name\" content=\"OSO ARUBA JEEP TOURS\" />\n<meta property=\"og:type\" content=\"website\" />\n\n<!-- Twitter Card Tags -->\n<meta name=\"twitter:card\" content=\"summary_large_image\" />\n<meta name=\"twitter:title\" content=\"OSO ARUBA JEEP TOURS\" />\n<meta name=\"twitter:description\" content=\"OSO Your Leading Aruba Jeep Tour Operator. Explore Aruba’s wild side in a Jeep with your own local guide.\" />\n<meta name=\"twitter:image\" content=\"https://osoarubatour.com/assets/images/oso-logo-circle-logo.png\" />\n\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Product\",\n  \"image\": {\n    \"@type\": \"ImageObject\",\n    \"url\": \"https://osoarubatour.com/OSO-Aruba-Tours-Activities\"\n  },\n  \"brand\": {\n    \"@type\": \"Brand\",\n    \"name\": \"OSO ARUBA JEEP TOURS\"\n  },\n  \"review\": {\n    \"@type\": \"Review\",\n    \"reviewRating\": {\n      \"@type\": \"Rating\"\n    },\n    \"author\": {\n      \"@type\": \"Person\"\n    }\n  },\n  \"aggregateRating\": {\n    \"@type\": \"AggregateRating\"\n  },\n  \"offers\": {\n    \"@type\": \"Offer\",\n    \"availability\": \"InStock\"\n  },\n  \"name\": \"Jeep Tours & Activities\",\n  \"description\": \"Ready for an adventure? Come and discover Aruba in a totally different way! See here all the tours we have available for you, and join us for an unforgettable experience.\"\n}\n</script>\n\n\n\n\n",
