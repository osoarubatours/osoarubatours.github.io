    "OSO-Aruba-Tours-Activities.html": {
      "settings": {
        "title": "OSO Aruba Tours and Activities",
        "meta_descr": "OSO Aruba Jeep Tours offers a full-day adventure tour specializing in the exploration of Aruba’s natural beauty. Go off the beaten path as you explore the rugged, unspoiled Aruba countryside on a 4x4 jeep and visit the island’s hidden gems.",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "order": "2",
        "meta_image": "@PROJECT_PATH@/assets/images/oso-jeep-tour-island-aruba.webp"
      },
