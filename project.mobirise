                    "padding": "1rem"
                  }
                }
              }
            },
            ".mbr-section-btn": {
              "margin-top": "auto !important"
            },
            ".mbr-section-title": {
              "color": "#22a5e5"
            },
            ".mbr-text, .mbr-section-btn": {
              "text-align": "center",
